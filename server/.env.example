PORT=5000
NODE_ENV=development
# Local frontend during development:
# CLIENT_URL=http://localhost:5173
# Render production frontend domain:
CLIENT_URL=https://dengueshield-ai.onrender.com
MONGODB_URI=mongodb+srv://minul:YOUR_PASSWORD@cluster0.d0l421o.mongodb.net/dengueshield?retryWrites=true&w=majority&appName=Cluster0
# Optional fallback if SRV DNS fails (use Atlas "Standard connection string" here):
# MONGODB_URI_NON_SRV=mongodb://minul:YOUR_PASSWORD@ac-xxxx-shard-00-00.d0l421o.mongodb.net:27017,ac-xxxx-shard-00-01.d0l421o.mongodb.net:27017,ac-xxxx-shard-00-02.d0l421o.mongodb.net:27017/dengueshield?replicaSet=atlas-xxxx-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority
MONGODB_DB_NAME=dengueshield
MONGODB_MAX_RETRIES=5
MONGODB_RETRY_DELAY_MS=2000
JWT_SECRET=replace_with_a_long_random_secret
# Required on Render for Smart Doctor chat (Node falls back to Groq when Python ML is unavailable).
GROQ_API_KEY=your_groq_api_key
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_MODEL=llama-3.1-8b-instant

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
GRAPHRAG_CACHE_TTL_MS=300000

# Local Python RAG service only. Do not set to localhost on Render — Smart Doctor uses Groq directly.
ML_API_URL=http://127.0.0.1:5001

